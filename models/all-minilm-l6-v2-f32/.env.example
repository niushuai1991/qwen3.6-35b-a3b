# === llama.cpp 构建 ===
LLAMA_CPP_REF=b9542
# CUDA 架构：RTX 4080 = 89；5060 Ti Blackwell = 120（需 CUDA 12.10+ builder）
# 多卡混合用分号分隔，如 "89;90"
CUDA_ARCHITECTURES=89

# === 对外端口 ===
PORT=8080

# === 模型（宿主路径 + 文件名）===
# 改成你机器上的实际路径
MODEL_HOST_DIR=/path/to/your/models/all-MiniLM-L6-v2-f32
MODEL_FILE=all-MiniLM-L6-v2-f32.gguf

# === 推理参数 ===
CONTEXT_SIZE=256
# 透传给 llama-server 的额外参数
EXTRA_ARGS=

# === 下载源 ===
HF_REPO=niushuai1991/all-MiniLM-L6-v2-f32-GGUF
HF_ENDPOINT=https://hf-mirror.com
