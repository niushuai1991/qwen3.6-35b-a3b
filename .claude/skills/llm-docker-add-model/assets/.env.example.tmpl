# === llama.cpp 构建 ===
LLAMA_CPP_REF={{LLAMA_CPP_REF}}
# CUDA 架构：RTX 4080 = {{CUDA_ARCHITECTURES}}；5060 Ti Blackwell = 120（需 CUDA 12.10+ builder）
# 多卡混合用分号分隔，如 "86;89"
CUDA_ARCHITECTURES={{CUDA_ARCHITECTURES}}

# === 对外端口 ===
PORT=8080

# === 模型（宿主路径 + 文件名）===
# 改成你机器上的实际路径
MODEL_HOST_DIR=/path/to/your/models/{{MODEL_DIR}}
MODEL_FILE={{MODEL_FILE}}
MMPROJ_FILE={{MMPROJ_FILE}}
# 多模态投影开关：纯文本场景可设 false 省显存
LOAD_MMPROJ=true

# === 推理参数 ===
CONTEXT_SIZE={{CONTEXT_SIZE}}
# 透传给 llama-server 的额外参数（如 --temp 0.7 --top-p 0.8）
EXTRA_ARGS=

# === 下载源 ===
HF_REPO={{HF_REPO}}
HF_ENDPOINT=https://hf-mirror.com
# modelscope 同名仓库，下载速度通常比 hf-mirror 快得多
MS_REPO={{MS_REPO}}
